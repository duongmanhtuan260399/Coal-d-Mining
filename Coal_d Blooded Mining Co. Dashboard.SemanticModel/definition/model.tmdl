annotation PBI_QueryOrder = ["Dim_clients","Dim_dates","Dim_employees","Dim_equipment","Dim_sites","Dim_times","Fact_invoices","Fact_ore_volumes","Fact_shifts","FolderPath","FolderPathCleaned","Dim_ExchangeRates","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_clients
