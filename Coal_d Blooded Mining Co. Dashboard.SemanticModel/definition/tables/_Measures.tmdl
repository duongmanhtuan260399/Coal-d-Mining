table _Measures
	lineageTag: ebe604f8-7464-4305-b461-0c92145ef6e3

	measure 'Invoice Amount (USD)' = ```
			
			SUMX(
			    Fact_invoices,
			    Fact_invoices[InvoiceAmount] * RELATED(Dim_ExchangeRates[USD_Rate])
			)
			
			```
		lineageTag: 04c68d10-a933-49f5-91d8-2f81dc9d72d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active Employees' = CALCULATE(DISTINCTCOUNT(Fact_shifts[EmployeeId]),Fact_shifts[ShiftType]="Attended")
		formatString: 0
		lineageTag: 024e3646-5db0-4fc2-b9ed-048796dc9147

	measure 'Active Machines' = CALCULATE(DISTINCTCOUNT(Dim_equipment[EquipmentId]),Dim_equipment[Status]="Active")
		formatString: 0
		lineageTag: 6f9f1604-cce8-494a-b2ee-10632bee98a5

	column Column1
		dataType: string
		lineageTag: 8b9b2566-9259-4fc8-a680-a6e21b883c4e
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
