	column 'Top Produce Country' =
			SWITCH(
				TRUE,
				ISBLANK('Dim_sites'[Country]),
				"(Blank)",
				'Dim_sites'[Country] IN {"Australia",
					"Burkina Faso",
					"Equatorial Guinea",
					"Philippines",
					"Saudi Arabia"},
				"Top 5",
				"Other"
			)
		lineageTag: d4ab6ba0-2544-436a-9a10-90386880e6d6
		summarizeBy: none

