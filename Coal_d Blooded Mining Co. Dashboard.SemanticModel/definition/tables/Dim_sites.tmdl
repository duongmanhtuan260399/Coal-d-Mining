				  ]
				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"d","Entity":"Dim_sites"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"d"}},"Property":"Country"}}],"GroupItems":[{"DisplayName":"(Blank)","BlankDefaultPlaceholder":true},{"DisplayName":"Top 5","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"d"}},"Property":"Country"}}],"Values":[[{"Literal":{"Value":"'Australia'"}}],[{"Literal":{"Value":"'Burkina Faso'"}}],[{"Literal":{"Value":"'Equatorial Guinea'"}}],[{"Literal":{"Value":"'Philippines'"}}],[{"Literal":{"Value":"'Saudi Arabia'"}}]]}}},{"DisplayName":"Other"}]}

